{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LolUp",
  "version": "0.1.0",
  "identifier": "app.lolup.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LolUp",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 600
      },
      {
        "label": "overlay",
        "title": "LolUp plan",
        "url": "index.html#overlay",
        "width": 340,
        "height": 320,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: lcu: http://lcu.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
